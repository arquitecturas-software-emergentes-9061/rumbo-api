# Copy to `.env` (ignored by git) and adjust. Never commit real secrets.
DB_NAME=rumbo
DB_URL=jdbc:postgresql://localhost:5432/rumbo
DB_USERNAME=rumbo
DB_PASSWORD=rumbo
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
# HS256 signing key for access tokens: at least 32 random bytes. Generate one with `openssl rand -base64 48`.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Local SMTP receiver: http://localhost:8025 (messages stay on this machine).
# For deployment, enable delivery and supply your SMTP host, credentials, TLS and a public HTTPS reset page.
RECOVERY_MAIL_ENABLED=true
RECOVERY_MAIL_FROM=no-reply@rumbo.local
RECOVERY_RESET_PAGE=http://localhost:4200/restablecer-clave
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
